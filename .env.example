# Copy this file to .env and fill in your own Supabase project's values.
# These are NOT sensitive — the anon key is designed to be public and is
# protected by Row Level Security policies (see README.md). They just live
# here instead of hardcoded in source so you can change them without editing code.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
